# ---------------------------------------------------------------------------
# Alstom AO - orchestration layer configuration
# Copy to .env and adjust. Values below are safe local defaults.
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
AO_APP_NAME="Alstom AO"
AO_ENVIRONMENT=dev
AO_DEBUG=false
AO_HOST=0.0.0.0
AO_PORT=8080
AO_CORS_ORIGINS=*
AO_DB_AUTO_CREATE=true
AO_SEED_DEMO_AGENTS=true

# --- Database (Postgres in production) -------------------------------------
# AO_DATABASE_URL=postgresql+asyncpg://alstom:alstom@localhost:5432/alstom_ao
AO_DATABASE_URL=sqlite+aiosqlite:///./alstom_ao.db
AO_DB_ECHO=false

# --- Identity --------------------------------------------------------------
# User identity arrives from the UI as headers (X-User-Id, X-User-Roles, ...).
AO_REQUIRE_USER_IDENTITY=true
AO_TRUST_FORWARDED_IDENTITY=true
AO_DEFAULT_USER_ROLES=user
AO_SERVICE_ID=alstom-ao
AO_SERVICE_NAME=agent-orchestrator

# --- LLM gateway (LiteLLM) -------------------------------------------------
# AO_LLM_MODE=litellm
AO_LLM_MODE=mock
AO_LLM_MODEL=openai/gpt-4o-mini
AO_LLM_API_BASE=
AO_LLM_API_KEY=
AO_LLM_FALLBACK_MODELS=openai/gpt-4.1-mini,anthropic/claude-3-5-haiku-latest
AO_LLM_TEMPERATURE=0.0
AO_LLM_MAX_TOKENS=1200
AO_LLM_TIMEOUT_SECONDS=45
AO_LLM_MAX_RETRIES=2
AO_LLM_MAX_TOKENS_PER_RUN=20000
AO_LLM_MAX_COST_USD_PER_RUN=0.50
AO_LLM_MAX_CALLS_PER_RUN=12
AO_PLANNER_MIN_CONFIDENCE=0.35
AO_PLANNER_MAX_AGENTS=4

# --- Agent adapters --------------------------------------------------------
AO_A2A_TIMEOUT_SECONDS=30
AO_A2A_MAX_RETRIES=2
AO_A2A_DISCOVERY_PATH=/.well-known/agent-card.json
AO_A2A_LEGACY_DISCOVERY_PATH=/.well-known/agent.json
AO_MAX_PARALLEL_AGENTS=4
AO_RUN_TIMEOUT_SECONDS=120

# --- A2A routing -----------------------------------------------------------
# direct        -> call each agent's own endpoint
# litellm_proxy -> call the LiteLLM agent gateway: POST {AO_LITELLM_PROXY_URL}/a2a/{agent}
AO_A2A_ROUTING=direct
AO_LITELLM_PROXY_URL=http://localhost:4000
AO_LITELLM_PROXY_API_KEY=
AO_LITELLM_PROXY_API_KEY_REF=env:AO_LITELLM_VIRTUAL_KEY
AO_LITELLM_AGENT_PREFIX=/a2a
AO_LITELLM_A2A_PROTOCOL_VERSION=0.3
AO_LITELLM_FORWARD_TRACE_HEADERS=true

# --- Policy (OPA) ----------------------------------------------------------
AO_POLICY_MODE=observe          # observe | enforce
AO_OPA_URL=http://localhost:8181
AO_OPA_DECISION_PATH=alstom/authz/decision
AO_OPA_TIMEOUT_SECONDS=2.0
AO_POLICY_LOCAL_FALLBACK=true

# --- Approvals -------------------------------------------------------------
AO_APPROVAL_RISK_THRESHOLD=high
AO_APPROVAL_TTL_MINUTES=120
AO_APPROVAL_ADMIN_ROLES=platform-admin,approver
AO_APPROVAL_ADMIN_BYPASS=false
AO_APPROVAL_ALLOW_SELF=false

# --- Observability (Langfuse) ----------------------------------------------
AO_LANGFUSE_ENABLED=false
AO_LANGFUSE_PUBLIC_KEY=
AO_LANGFUSE_SECRET_KEY=
AO_LANGFUSE_HOST=https://cloud.langfuse.com
AO_TRACE_SAMPLE_RATE=1.0

# --- Secrets for downstream agents ----------------------------------------
# Agent cards store a secret *reference*, never the secret itself, e.g.
#   AO_SECRET_FINANCE_TOKEN=...
# resolved through resolve_secret("env:AO_SECRET_FINANCE_TOKEN").
