  "platform": "reference",
  "protocol": "a2a",
  "endpoint": "http://reference-agent:9101/agents/finance",
  "owner": "Reference",
  "capabilities": [
    "invoice audit",
    "duplicate invoice detection",
    "vendor payment status"
